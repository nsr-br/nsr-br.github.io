---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Page from './Page.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, heroAlt, tags, draft } = Astro.props;
---

<Page title={title} description={description} image={heroImage} type="article">
	<article>
		<header class="cabeca">
			{draft && <p class="rascunho">Rascunho: não aparece no site publicado</p>}
			<p class="data">
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<span class="atualizado">
							Atualizado em <FormattedDate date={updatedDate} />
						</span>
					)
				}
			</p>
			<h1>{title}</h1>
			<p class="resumo">{description}</p>
			{
				tags.length > 0 && (
					<ul class="tags" aria-label="Tags">
						{tags.map((tag) => (
							<li>#{tag}</li>
						))}
					</ul>
				)
			}
		</header>
		{
			heroImage && (
				<Image
					class="capa"
					src={heroImage}
					alt={heroAlt ?? ''}
					widths={[400, 720, 1100]}
					sizes="(min-width: 46rem) 42rem, 100vw"
					loading="eager"
				/>
			)
		}
		<div class="texto">
			<slot />
		</div>
	</article>
</Page>
<style>
	.cabeca {
		margin-bottom: 2rem;
	}
	.data {
		margin: 0 0 0.75rem;
		color: var(--cinza);
		font-size: 0.95rem;
	}
	.atualizado {
		display: block;
		font-size: 0.85rem;
	}
	h1 {
		margin-bottom: 0.4em;
	}
	.resumo {
		margin: 0 0 1rem;
		color: var(--cinza);
		font-size: 1.15em;
		line-height: 1.45;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.9rem;
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--vermelho-texto);
		font-size: 0.95rem;
	}
	.tags li {
		margin: 0;
	}
	.rascunho {
		display: inline-block;
		margin: 0 0 1rem;
		padding: 0.2em 0.6em;
		border: 1px solid var(--vermelho);
		border-radius: 3px;
		color: var(--papel);
		font-size: 0.85rem;
	}
	.capa {
		width: calc(100% + 2 * var(--margem));
		max-width: none;
		margin: 0 calc(-1 * var(--margem)) 2rem;
		border-radius: 0;
	}
	@media (min-width: 46rem) {
		.capa {
			width: 100%;
			margin: 0 0 2.5rem;
			border-radius: 4px;
		}
	}
	.texto :global(h2:first-child),
	.texto :global(h3:first-child) {
		margin-top: 0;
	}
	.texto :global(img) {
		margin: 2em 0;
	}
</style>
