---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { url } from '../utils/url';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{
	posts.length === 0 ? (
		<p class="vazio">
			Nenhum post publicado ainda. Escreva o primeiro pelo painel, em <code>/admin</code>.
		</p>
	) : (
		<ul>
			{posts.map((post) => (
				<li>
					<a href={url(`/blog/${post.id}/`)}>
						{post.data.heroImage && (
							<Image
								src={post.data.heroImage}
								alt={post.data.heroAlt ?? ''}
								widths={[400, 720, 1100]}
								sizes="(min-width: 46rem) 42rem, 100vw"
							/>
						)}
						<p class="data">
							<FormattedDate date={post.data.pubDate} />
							{post.data.draft && <span class="rascunho">rascunho</span>}
						</p>
						<h2>{post.data.title}</h2>
						<p class="resumo">{post.data.description}</p>
					</a>
				</li>
			))}
		</ul>
	)
}
<style>
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		margin: 0;
		border-top: 1px solid var(--linha);
	}
	a {
		display: block;
		padding: 1.5rem 0 1.75rem;
		color: inherit;
		text-decoration: none;
	}
	img {
		width: 100%;
		margin-bottom: 1rem;
		aspect-ratio: 2 / 1;
		object-fit: cover;
	}
	.data {
		margin: 0 0 0.4rem;
		color: var(--cinza);
		font-size: 0.9rem;
	}
	h2 {
		margin: 0 0 0.45rem;
		font-size: clamp(1.75rem, 7vw, 2.3rem);
		text-decoration-color: var(--vermelho);
		text-decoration-thickness: 3px;
		text-underline-offset: 0.12em;
	}
	a:hover h2 {
		text-decoration-line: underline;
	}
	.resumo {
		margin: 0;
		color: var(--cinza);
		line-height: 1.5;
	}
	.rascunho {
		margin-left: 0.6em;
		padding: 0 0.45em;
		border: 1px solid var(--vermelho);
		border-radius: 3px;
		color: var(--papel);
		font-size: 0.8rem;
	}
	.vazio {
		color: var(--cinza);
	}
</style>
