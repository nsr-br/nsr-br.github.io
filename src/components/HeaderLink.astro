---
import type { HTMLAttributes } from 'astro/types';
import { url } from '../utils/url';

// `href` é o caminho sem o base (ex.: '/blog/'); o componente prefixa sozinho.
type Props = HTMLAttributes<'a'> & { href: string };

const { href, class: className, ...props } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname.slice(base.length) || '/';
const section = '/' + (pathname.match(/[^/]+/)?.[0] ?? '');
const target = '/' + (href.match(/[^/]+/)?.[0] ?? '');
const isActive = section === target;
---

<a href={url(href)} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
</style>
