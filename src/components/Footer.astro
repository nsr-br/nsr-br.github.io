---
import { SITE_TITLE } from '../consts';
import { url } from '../utils/url';

const today = new Date();
---

<footer>
	<div class="dentro">
		<p class="nome">{SITE_TITLE}</p>
		<ul>
			<li><a href={url('/blog/')}>Posts</a></li>
			<li><a href={url('/sobre/')}>Sobre</a></li>
			<li><a href={url('/rss.xml')}>RSS</a></li>
		</ul>
		<p class="ano">&copy; {today.getFullYear()}</p>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid var(--linha);
		color: var(--cinza);
		font-size: 0.95rem;
	}
	.dentro {
		max-width: calc(var(--medida) + 2 * var(--margem));
		margin: 0 auto;
		padding: 2rem var(--margem) 3rem;
	}
	.nome {
		margin: 0 0 0.75rem;
		color: var(--papel);
		font-weight: 800;
		font-stretch: var(--cartaz);
		font-size: 1.4rem;
		line-height: 1;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		margin: 0 0 1.5rem;
		padding: 0;
		list-style: none;
	}
	li {
		margin: 0;
	}
	a {
		color: var(--cinza);
	}
	a:hover {
		color: var(--papel);
	}
	.ano {
		margin: 0;
		font-size: 0.85rem;
	}
</style>
