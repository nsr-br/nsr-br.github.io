---
import { SITE_TITLE } from '../consts';
import { url } from '../utils/url';
import HeaderLink from './HeaderLink.astro';
import RssIcon from './RssIcon.astro';
---

<header>
	<nav>
		<a class="brand" href={url('/')}>
			<img src={url('/favicon.svg')} alt="" width="34" height="34" />
			<span>{SITE_TITLE}</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Início</HeaderLink>
			<HeaderLink href="/blog/">Posts</HeaderLink>
			<HeaderLink href="/sobre/">Sobre</HeaderLink>
			<a class="rss" href={url('/rss.xml')} title="Assinar o RSS">
				<span class="sr-only">Assinar o RSS</span>
				<RssIcon />
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--ink);
		border-bottom: 4px solid var(--accent);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		max-width: 960px;
		margin: 0 auto;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6em;
		padding: 0.6em 0;
		color: #fff;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-decoration: none;
	}
	.brand img {
		border-radius: 50%;
	}
	.internal-links {
		display: flex;
		align-items: center;
	}
	.internal-links a {
		padding: 1em 0.6em;
		color: rgba(255, 255, 255, 0.82);
		border-bottom: 4px solid transparent;
		margin-bottom: -4px;
		text-decoration: none;
	}
	.internal-links a:hover {
		color: #fff;
	}
	.internal-links a.active {
		color: #fff;
		border-bottom-color: #fff;
	}
	.rss {
		display: flex;
	}
	@media (max-width: 560px) {
		nav {
			justify-content: center;
		}
		.internal-links a {
			padding: 0.6em 0.5em 0.9em;
		}
	}
</style>
