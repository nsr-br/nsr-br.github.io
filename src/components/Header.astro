---
import { SITE_TITLE } from '../consts';
import { getMenu } from '../lib/paginas';
import { url } from '../utils/url';
import HeaderLink from './HeaderLink.astro';
import Logo from './Logo.astro';
import RssIcon from './RssIcon.astro';

const menu = await getMenu();
---

<header>
	<nav aria-label="Principal">
		<a class="marca" href={url('/')}>
			<Logo size={36} eager />
			<span>{SITE_TITLE}</span>
		</a>
		<div class="links">
			<HeaderLink href="/blog/">Posts</HeaderLink>
			{menu.map((item) => <HeaderLink href={item.href}>{item.label}</HeaderLink>)}
			<a class="rss" href={url('/rss.xml')} title="Assinar o RSS">
				<span class="sr-only">Assinar o RSS</span>
				<RssIcon />
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		border-bottom: 1px solid var(--linha);
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0 0.75rem;
		max-width: calc(var(--medida) + 2 * var(--margem));
		margin: 0 auto;
		padding: 0.6rem var(--margem);
	}
	.marca {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--papel);
		font-weight: 800;
		font-stretch: var(--cartaz);
		font-size: 1.2rem;
		line-height: 1;
		letter-spacing: 0.02em;
		text-decoration: none;
		white-space: nowrap;
	}
	.marca :global(img) {
		border-radius: 0;
	}
	/* Se o menu não couber ao lado do logo, desce para uma segunda linha e rola de lado. */
	.links {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		max-width: calc(100% + 1rem);
		margin: 0 -0.5rem;
		overflow-x: auto;
		scrollbar-width: none;
	}
	.links a {
		display: flex;
		align-items: center;
		min-height: 2.75rem;
		padding: 0 0.5rem;
		color: var(--cinza);
		font-size: 1rem;
		text-decoration: none;
		white-space: nowrap;
	}
	.links a:hover,
	.links a.active {
		color: var(--papel);
	}
	.links a.active {
		text-decoration: underline;
		text-decoration-color: var(--vermelho);
		text-decoration-thickness: 3px;
		text-underline-offset: 0.45em;
	}
</style>
