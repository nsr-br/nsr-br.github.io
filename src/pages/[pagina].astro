---
import { type CollectionEntry, render } from 'astro:content';
import Page from '../layouts/Page.astro';
import { COM_PAGINA_PROPRIA, getPaginas } from '../lib/paginas';

// Uma rota para todas as páginas criadas no painel: /sobre/, /repositorio-br/...
export async function getStaticPaths() {
	const paginas = (await getPaginas()).filter((p) => !COM_PAGINA_PROPRIA.has(p.id));
	return paginas.map((pagina) => ({
		params: { pagina: pagina.id },
		props: pagina,
	}));
}
type Props = CollectionEntry<'paginas'>;

const pagina = Astro.props;
const { Content } = await render(pagina);
---

<Page title={pagina.data.title} description={pagina.data.description}>
	<h1>{pagina.data.title}</h1>
	<Content />
</Page>
