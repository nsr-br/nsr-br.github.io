---
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Page from '../layouts/Page.astro';
import { getPosts } from '../lib/posts';
import { url } from '../utils/url';

const LATEST = 6;
const posts = await getPosts();
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION} wide>
	<section class="hero">
		<h1>{SITE_TITLE}</h1>
		<p>{SITE_DESCRIPTION}</p>
	</section>
	<section>
		<h2 class="section-title">Últimos posts</h2>
		<PostList posts={posts.slice(0, LATEST)} />
		{
			posts.length > LATEST && (
				<p class="more">
					<a href={url('/blog/')}>Ver todos os posts →</a>
				</p>
			)
		}
	</section>
</Page>
<style>
	.hero {
		margin-bottom: 3rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.hero h1 {
		margin: 0;
		letter-spacing: 0.04em;
	}
	.hero p {
		margin: 0.3em 0 0;
		color: rgb(var(--gray));
	}
	.section-title {
		margin-bottom: 1.5rem;
		font-size: 0.8em;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.more {
		margin-top: 2.5rem;
		text-align: center;
	}
	@media (max-width: 720px) {
		.hero h1 {
			font-size: 2.2em;
		}
	}
</style>
