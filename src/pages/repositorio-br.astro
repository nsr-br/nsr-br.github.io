---
import { getCollection, getEntry, render } from 'astro:content';
import { ESTILOS, TIPOS } from '../content.config';
import JogoCard from '../components/JogoCard.astro';
import Page from '../layouts/Page.astro';

// Título, resumo e texto de abertura vêm de Páginas → Repositório BR, no painel.
// Os jogos vêm da coleção Repositório BR (src/content/jogos).
const pagina = await getEntry('paginas', 'repositorio-br');
if (!pagina) throw new Error('src/content/paginas/repositorio-br/index.md não encontrado');
const { Content } = await render(pagina);

const jogos = (await getCollection('jogos')).sort((a, b) =>
	a.data.title.localeCompare(b.data.title, 'pt-BR'),
);

// Só vira filtro o que tem pelo menos dois valores diferentes no catálogo.
const tipos = TIPOS.filter((t) => jogos.some((j) => j.data.tipo === t));
const estilos = ESTILOS.filter((e) => jogos.some((j) => j.data.estilos.includes(e)));
const contagem = (n: number) => (n === 1 ? '1 jogo' : `${n} jogos`);
---

<Page title={pagina.data.title} description={pagina.data.description}>
	<h1>{pagina.data.title}</h1>
	<p class="resumo">{pagina.data.description}</p>
	<Content />

	{
		jogos.length === 0 ? (
			<p class="vazio">
				Nenhum jogo cadastrado ainda. Cadastre o primeiro pelo painel, em <strong>Repositório BR → Novo</strong>.
			</p>
		) : (
			<>
				<form class="filtros" role="search" hidden>
					<label class="busca">
						<span class="sr-only">Buscar por nome, autoria ou descrição</span>
						<input type="search" name="q" placeholder="Buscar jogo ou autoria" autocomplete="off" />
					</label>
					{tipos.length > 1 && (
						<fieldset>
							<legend>Tipo</legend>
							<label><input type="radio" name="tipo" value="" checked /> Todos</label>
							{tipos.map((t) => (
								<label><input type="radio" name="tipo" value={t} /> {t}</label>
							))}
						</fieldset>
					)}
					{estilos.length > 1 && (
						<fieldset>
							<legend>Estilo</legend>
							<label><input type="radio" name="estilo" value="" checked /> Todos</label>
							{estilos.map((e) => (
								<label><input type="radio" name="estilo" value={e} /> {e}</label>
							))}
						</fieldset>
					)}
				</form>
				<p class="contagem" aria-live="polite" data-total={jogos.length}>{contagem(jogos.length)}</p>
				<ul class="catalogo">
					{jogos.map((jogo) => <JogoCard jogo={jogo} />)}
				</ul>
				<p class="nenhum" hidden>Nenhum jogo com esses filtros. Limpe a busca ou escolha "Todos".</p>
			</>
		)
	}
</Page>

<script>
	// Filtro no navegador. Sem JavaScript, o catálogo aparece inteiro e o formulário fica escondido.
	const form = document.querySelector<HTMLFormElement>('.filtros');
	const contagem = document.querySelector<HTMLElement>('.contagem');
	const nenhum = document.querySelector<HTMLElement>('.nenhum');
	const jogos = [...document.querySelectorAll<HTMLElement>('.catalogo > .jogo')];
	const normalizar = (t: string) => t.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase().trim();

	function filtrar() {
		if (!form) return;
		const dados = new FormData(form);
		const q = normalizar(String(dados.get('q') ?? ''));
		const tipo = String(dados.get('tipo') ?? '');
		const estilo = String(dados.get('estilo') ?? '');
		let visiveis = 0;
		for (const jogo of jogos) {
			const ok =
				(!q || (jogo.dataset.busca ?? '').includes(q)) &&
				(!tipo || jogo.dataset.tipo === tipo) &&
				(!estilo || (jogo.dataset.estilos ?? '').split('|').includes(estilo));
			jogo.hidden = !ok;
			if (ok) visiveis++;
		}
		const total = jogos.length;
		if (contagem) {
			const nome = (n: number) => (n === 1 ? '1 jogo' : `${n} jogos`);
			contagem.textContent = visiveis === total ? nome(total) : `${visiveis} de ${nome(total)}`;
		}
		if (nenhum) nenhum.hidden = visiveis > 0;
	}

	if (form) {
		form.hidden = false;
		form.addEventListener('input', filtrar);
		form.addEventListener('submit', (e) => e.preventDefault());
	}
</script>

<style>
	.resumo {
		margin: 0 0 1.5rem;
		color: var(--cinza);
		font-size: 1.15em;
		line-height: 1.45;
	}
	.filtros {
		display: grid;
		gap: 0.9rem;
		margin: 2rem 0 0;
	}
	.filtros[hidden] {
		display: none;
	}
	.busca input {
		width: 100%;
		min-height: 2.9rem;
		padding: 0.5rem 0.9rem;
		border: 1px solid var(--linha);
		border-radius: 4px;
		background: var(--carvao);
		color: var(--papel);
		font: inherit;
		font-size: 1rem;
	}
	.busca input::placeholder {
		color: var(--cinza);
	}
	.busca input:focus-visible {
		outline: 2px solid var(--papel);
		outline-offset: 1px;
	}
	fieldset {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin: 0;
		padding: 0;
		border: none;
	}
	legend {
		margin-bottom: 0.4rem;
		color: var(--cinza);
		font-size: 0.9rem;
	}
	/* Opções do filtro como botões: o rádio fica escondido, o rótulo é o que se toca. */
	fieldset label {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-height: 2.5rem;
		padding: 0 0.9rem;
		border: 1px solid var(--linha);
		border-radius: 999px;
		color: var(--cinza);
		font-size: 0.95rem;
		cursor: pointer;
	}
	fieldset input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}
	fieldset label:has(input:checked) {
		border-color: var(--vermelho);
		background: var(--vermelho);
		color: var(--papel);
	}
	fieldset label:has(input:focus-visible) {
		outline: 2px solid var(--papel);
		outline-offset: 2px;
	}
	.contagem {
		margin: 1.5rem 0 1rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--linha);
		color: var(--cinza);
		font-size: 0.95rem;
	}
	.catalogo {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	@media (min-width: 36rem) {
		.catalogo {
			grid-template-columns: 1fr 1fr;
		}
	}
	.catalogo > :global(.jogo[hidden]) {
		display: none;
	}
	.nenhum,
	.vazio {
		color: var(--cinza);
	}
</style>
